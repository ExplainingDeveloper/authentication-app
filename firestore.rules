rules_version = '2';

// 파이어스토어 보안 규칙.
//
// 규칙을 안 쓰면 데이터베이스는 두 가지 중 하나로 시작한다.
// 테스트 모드(누구나 읽고 쓸 수 있음, 30일 뒤 잠김) 또는
// 잠금 모드(아무도 못 씀). 둘 다 실제로 쓸 수 있는 상태가 아니다.
//
// 규칙은 앱이 아니라 서버에서 검사한다.
// 그래서 앱 코드를 아무리 잘 짜도 규칙이 열려 있으면 소용없다.
// 남의 uid로 요청을 보내면 그대로 통과한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 프로필.
    //
    // {userId}는 문서 이름이 그 자리에 들어온다는 뜻이다.
    // 우리는 문서 이름으로 uid를 쓰기로 했으므로,
    // "문서 이름 == 로그인한 사람의 uid" 조건 하나로
    // 남의 정보를 못 보게 막을 수 있다.
    //
    // 문서 이름이 자동 생성 ID였다면 이 비교 자체가 불가능하다.
    // add() 대신 doc(uid).set()을 쓴 이유가 여기 있다.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 위에서 허용하지 않은 나머지는 전부 막는다.
    // 규칙은 위에서부터 훑어보다 허용되는 게 하나라도 있으면 통과시키는
    // 방식이라, 이 줄이 있어도 위의 users 규칙은 그대로 동작한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
